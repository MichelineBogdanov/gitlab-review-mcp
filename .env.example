gitlab.base-url=https://gitlab.example.com
gitlab.token=replace-me
gitlab.connect-timeout=PT5S
gitlab.read-timeout=PT30S
gitlab.max-response-size=10MB
gitlab.max-diff-size=5MB
gitlab.max-files=500
gitlab.ssl.trust-store-path=
gitlab.ssl.trust-store-password=
gitlab.ssl.trust-store-type=PKCS12
review.proposal-ttl=PT15M
review.proposal-max-count=100
review.max-comments=50
review.max-comment-length=10000
